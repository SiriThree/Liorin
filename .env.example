# ============================================================================
# LIORIN CONFIGURATION
# ============================================================================

# Default model for all agents.
# Use OpenAI-compatible domestic API endpoints via OPENAI_BASE_URL.
# Examples:
#   LIORIN_MODEL="openai:deepseek-chat"
#   LIORIN_MODEL="openai:qwen-plus"
#   LIORIN_MODEL="openai:glm-4-flash"
LIORIN_MODEL="openai:deepseek-chat"

# Provider-neutral budget for runtime-selected context items.  Full graph
# history remains checkpointed, while the supervisor model receives a bounded
# context view.  Increase only after evaluating latency/cost/quality tradeoffs.
LIORIN_CONTEXT_MAX_TOKENS="4096"

# Context Compaction runs before Selector/Budget when full ContextItems exceed
# the token budget or item threshold. It creates an ephemeral structured
# summary; original messages/checkpoints/traces are not deleted or overwritten.
LIORIN_CONTEXT_COMPACTION_ENABLED="true"
LIORIN_CONTEXT_COMPACTION_ITEM_THRESHOLD="24"
LIORIN_CONTEXT_COMPACTION_RECENT_MESSAGES="6"
LIORIN_CONTEXT_COMPACTION_SUMMARY_MAX_TOKENS="512"

# Embedding provider for document retrieval.
# Options: "huggingface" (local, no API key) or "openai" (requires OPENAI_API_KEY)
# Changing providers requires rebuilding the Milvus collection:
#   uv run python data/data_generation/build_vectorstore.py
EMBEDDING_PROVIDER="huggingface"

# Milvus vector database for manuals and support policy retrieval.
MILVUS_URI="http://localhost:19530"
MILVUS_TOKEN=""
MILVUS_COLLECTION="liorin_documents_huggingface"

# ============================================================================
# LANGSMITH CONFIGURATION
# ============================================================================

LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="liorin"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_ENDPOINT=""

# ============================================================================
# MODEL PROVIDER API KEYS
# ============================================================================

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com"

AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION=""

ANTHROPIC_API_KEY=""

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION_NAME=""
AWS_MODEL_ARN=""

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

LANGGRAPH_DEPLOYMENT_URL=""

# Phase 5 structured long-term memory retrieval
LIORIN_LONG_TERM_MEMORY_ENABLED=true
LIORIN_LONG_TERM_MEMORY_RETRIEVAL_LIMIT=6

# ============================================================================
# PHASE 7 PRODUCTION PLATFORM
# ============================================================================

# memory: process-local reference backend; postgres: durable DBAPI backend.
LIORIN_STORAGE_BACKEND="memory"
LIORIN_POSTGRES_DSN="postgresql://liorin:liorin@postgres:5432/liorin"
LIORIN_POSTGRES_SCHEMA="liorin"

# Redis is a read-through cache only; PostgreSQL/in-memory backend remains the
# source of truth. Cache writes are invalidated on fact/artifact mutation.
LIORIN_REDIS_ENABLED="false"
LIORIN_REDIS_URL="redis://redis:6379/0"
LIORIN_CACHE_TTL_SECONDS="60"

# Backend reliability controls.
LIORIN_BACKEND_RETRY_ATTEMPTS="3"
LIORIN_BACKEND_TIMEOUT_SECONDS="3"
LIORIN_CIRCUIT_FAILURE_THRESHOLD="5"
LIORIN_CIRCUIT_RECOVERY_SECONDS="30"
LIORIN_TOOL_TIMEOUT_SECONDS="30"

# Unified runtime telemetry. prometheus exposes a dependency-free pull
# snapshot; OpenTelemetry adapters can be selected by a production integration.
LIORIN_OBSERVABILITY_ENABLED="true"
LIORIN_METRICS_EXPORTER="prometheus"
